SET NOCOUNT ON;

-- Create a temporary table to store the results
IF OBJECT_ID('tempdb..#FragmentedIndexes') IS NOT NULL
    DROP TABLE #FragmentedIndexes;

CREATE TABLE #FragmentedIndexes (
    DatabaseName NVARCHAR(128),
    SchemaName NVARCHAR(128),
    TableName NVARCHAR(128),
    IndexName NVARCHAR(128),
    IndexID INT,
    FragmentationPercent FLOAT,
    PageCount BIGINT,
    IndexType NVARCHAR(60),
    Partition INT
);

-- Declare variables for the cursor
DECLARE @DatabaseName NVARCHAR(128);
DECLARE @SQL NVARCHAR(MAX);

-- Create a cursor to iterate through all user databases
DECLARE db_cursor CURSOR FOR
SELECT name
FROM sys.databases
WHERE database_id &gt; 4  -- Skip system databases
AND name like '%OIPA%'
AND state_desc = 'ONLINE'
AND is_read_only = 0;

-- Open the cursor
OPEN db_cursor;
FETCH NEXT FROM db_cursor INTO @DatabaseName;

-- Loop through each database
