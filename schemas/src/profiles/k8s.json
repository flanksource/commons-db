{
  "$id": "k8s.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "connection": {
      "description": "Pick a saved connection. Leave empty to use the ambient cluster ($KUBECONFIG, ~/.kube/config, or the in-cluster service account)",
      "title": "Connection",
      "type": "string",
      "x-clicky-lookup": {
        "filter": "connection",
        "multi": false,
        "scope": {
          "from": "provider.type",
          "map": {
            "azureloganalytics": [
              "azure"
            ],
            "bigquery": [
              "google_cloud"
            ],
            "clickhouse": [
              "clickhouse"
            ],
            "cloudwatch": [
              "aws"
            ],
            "gcpcloudlogging": [
              "google_cloud"
            ],
            "http": [
              "http"
            ],
            "jaeger": [
              "jaeger"
            ],
            "k8s": [
              "kubernetes"
            ],
            "loki": [
              "loki"
            ],
            "mysql": [
              "mysql"
            ],
            "opensearch": [
              "opensearch",
              "elasticsearch"
            ],
            "opentelemetry": [
              "opentelemetry"
            ],
            "postgres": [
              "postgres"
            ],
            "postgrest": [
              "http"
            ],
            "prometheus": [
              "prometheus"
            ],
            "sql": [
              "postgres",
              "mysql",
              "sql_server",
              "clickhouse"
            ],
            "sqlserver": [
              "sql_server"
            ]
          },
          "param": "types"
        },
        "searchParam": "__lookup_q",
        "url": "/api/v1/connection"
      }
    },
    "options": {
      "properties": {
        "containers": {
          "description": "Match expressions picking which containers of each pod are read",
          "items": {
            "type": "string"
          },
          "title": "Containers",
          "type": "array"
        },
        "end": {
          "description": "Date math, for example now",
          "title": "End",
          "type": "string"
        },
        "limit": {
          "description": "Maximum number of log lines",
          "title": "Limit",
          "type": "string"
        },
        "pods": {
          "description": "Resource selectors narrowing which of the workload's pods are read",
          "items": {
            "type": "object"
          },
          "title": "Pods",
          "type": "array"
        },
        "start": {
          "description": "Date math, for example now-1h",
          "title": "Start",
          "type": "string"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "type": {
      "const": "k8s",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "title": "Query provider: k8s",
  "type": "object"
}
