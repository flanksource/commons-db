{
  "$id": "cloudwatch.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "connection": {
      "description": "Pick a saved connection. Leave empty to use the ambient AWS credentials (environment, IRSA, or instance profile)",
      "title": "Connection",
      "type": "string",
      "x-clicky-lookup": {
        "filter": "connection",
        "multi": false,
        "scope": {
          "from": "provider.type",
          "map": {
            "azureloganalytics": [
              "azure"
            ],
            "bigquery": [
              "google_cloud"
            ],
            "clickhouse": [
              "clickhouse"
            ],
            "cloudwatch": [
              "aws"
            ],
            "gcpcloudlogging": [
              "google_cloud"
            ],
            "http": [
              "http"
            ],
            "jaeger": [
              "jaeger"
            ],
            "k8s": [
              "kubernetes"
            ],
            "loki": [
              "loki"
            ],
            "mysql": [
              "mysql"
            ],
            "opensearch": [
              "opensearch"
            ],
            "opentelemetry": [
              "opentelemetry"
            ],
            "postgres": [
              "postgres"
            ],
            "postgrest": [
              "http"
            ],
            "prometheus": [
              "prometheus"
            ],
            "sql": [
              "postgres",
              "mysql",
              "sql_server",
              "clickhouse"
            ],
            "sqlserver": [
              "sql_server"
            ]
          },
          "param": "types"
        },
        "searchParam": "__lookup_q",
        "url": "/api/v1/connection"
      }
    },
    "options": {
      "properties": {
        "end": {
          "description": "Date math, for example now",
          "title": "End",
          "type": "string"
        },
        "endpoint": {
          "description": "Inline CloudWatch endpoint used instead of the region's AWS endpoint",
          "title": "Endpoint",
          "type": "string",
          "x-clicky-component": "k8s-url-selector",
          "x-clicky-default-source": "value"
        },
        "limit": {
          "description": "Maximum number of log lines",
          "title": "Limit",
          "type": "string"
        },
        "logGroup": {
          "description": "Log group the Insights query runs against",
          "title": "Log group",
          "type": "string"
        },
        "mapping": {
          "description": "Maps source columns onto the canonical log fields",
          "properties": {
            "host": {
              "items": {
                "type": "string"
              },
              "title": "Host",
              "type": "array"
            },
            "id": {
              "items": {
                "type": "string"
              },
              "title": "Id",
              "type": "array"
            },
            "ignore": {
              "items": {
                "type": "string"
              },
              "title": "Ignore",
              "type": "array"
            },
            "message": {
              "items": {
                "type": "string"
              },
              "title": "Message",
              "type": "array"
            },
            "severity": {
              "items": {
                "type": "string"
              },
              "title": "Severity",
              "type": "array"
            },
            "source": {
              "items": {
                "type": "string"
              },
              "title": "Source",
              "type": "array"
            },
            "timestamp": {
              "items": {
                "type": "string"
              },
              "title": "Timestamp",
              "type": "array"
            }
          },
          "title": "Field mapping",
          "type": "object"
        },
        "region": {
          "description": "Overrides the region on the connection",
          "title": "Region",
          "type": "string"
        },
        "start": {
          "description": "Date math, for example now-1h. Defaults to now-1h — Insights requires a bounded range",
          "title": "Start",
          "type": "string"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "type": {
      "const": "cloudwatch",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "title": "Query provider: cloudwatch",
  "type": "object"
}
