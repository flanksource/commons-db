  "properties": {
    "connection": {
      "description": "Pick a saved connection or type an inline DSN/URL",
      "title": "Connection",
      "type": "string",
      "x-clicky-lookup": {
        "filter": "connection",
        "multi": false,
        "scope": {
          "from": "provider.type",
          "map": {
            "azureloganalytics": [
              "azure"
            ],
            "bigquery": [
              "google_cloud"
            ],
            "clickhouse": [
              "clickhouse"
            ],
            "cloudwatch": [
              "aws"
            ],
            "cloudwatchmetrics": [
              "aws"
            ],
            "gcpcloudlogging": [
              "google_cloud"
            ],
            "http": [
              "http"
            ],
            "jaeger": [
              "jaeger"
            ],
            "k8s": [
              "kubernetes"
            ],
            "loki": [
              "loki"
            ],
            "mysql": [
              "mysql"
            ],
            "opensearch": [
              "opensearch",
              "elasticsearch"
            ],
            "opentelemetry": [
              "opentelemetry"
            ],
            "postgres": [
              "postgres"
            ],
            "postgrest": [
              "http"
            ],
            "prometheus": [
              "prometheus"
            ],
            "sql": [
              "postgres",
              "mysql",
              "sql_server",
              "clickhouse",
              "sqlite"
            ],
            "sqlite": [
              "sqlite"
            ],
            "sqlserver": [
              "sql_server"
            ]
          },
          "param": "types"
        },
        "searchParam": "__lookup_q",
        "url": "/api/v1/connection"
      }
    },
    "options": {
      "properties": {
        "concurrency": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Concurrent metric batches",
          "type": "integer"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dimension filters",
          "type": "object"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "language": {
          "enum": [
            "metrics",
            "sql",
            "metrics-insights"
          ],
          "title": "Language",
          "type": "string"
        },
        "metrics": {
          "items": {
            "properties": {
              "dimensions": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "namespace": {
                "title": "Namespace",
                "type": "string"
              },
              "statistic": {
                "title": "Statistic",
                "type": "string"
              },
              "unit": {
                "title": "Unit",
                "type": "string"
              }
            },
            "required": [
              "name",
              "namespace"
            ],
            "type": "object"
          },
          "title": "Explicit metric identities",
          "type": "array"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "range": {
          "properties": {
            "end": {
              "description": "Date math, for example now",
              "title": "End",
              "type": "string"
            },
            "start": {
              "description": "Date math, for example now-1h",
              "title": "Start",
              "type": "string"
            },
            "step": {
              "description": "Sample step, for example 30s",
              "title": "Step",
              "type": "string"
            }
          },
          "title": "Range",
          "type": "object"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "statistic": {
          "title": "Statistic",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "type": {
      "const": "cloudwatchmetrics",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "title": "Query provider: cloudwatchmetrics",
  "type": "object"
}
