{
  "$id": "http.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "insecure_tls": {
      "title": "Insecure TLS",
      "type": "boolean",
      "x-clicky-order": 3
    },
    "logging": {
      "additionalProperties": false,
      "description": "Choose which sanitized connection activity is emitted at each log level.",
      "title": "Logging",
      "type": "object",
      "x-clicky-component": "connection-logging-policy",
      "x-clicky-logging": {
        "family": "http",
        "slowThreshold": "1s",
        "thresholdLabel": "Slow threshold",
        "events": [
          {
            "event": "error",
            "property": "log.level.error",
            "label": "Errors",
            "description": "Failed operations, including the sanitized request identity.",
            "default": "error",
            "captures": [
              "error",
              "operation",
              "duration"
            ],
            "example": {
              "connection": "search",
              "connection_level": "error",
              "duration_ms": 82,
              "error": "request timed out",
              "event": "error",
              "method": "POST",
              "provider": "http",
              "rows": 0,
              "status": 503,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] ERROR \u003e=[82ms] [rows:0] POST https://api.example.test/_search [503] request timed out"
          },
          {
            "event": "slow",
            "property": "log.level.slow",
            "label": "Slow operations",
            "description": "Successful operations at or above the slow threshold.",
            "default": "warn",
            "captures": [
              "operation",
              "duration",
              "slow threshold"
            ],
            "example": {
              "connection": "search",
              "connection_level": "warn",
              "duration_ms": 1200,
              "event": "slow",
              "method": "POST",
              "provider": "http",
              "rows": 1,
              "slow_threshold_ms": 1000,
              "status": 200,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] SLOW \u003e= [1200ms] [rows:1] POST https://api.example.test/_search [200]"
          },
          {
            "event": "http",
            "property": "log.level.http",
            "label": "Access summary",
            "description": "One method, sanitized URL, status and duration record per request.",
            "default": "debug",
            "captures": [
              "method",
              "URL",
              "status",
              "duration"
            ],
            "example": {
              "connection": "search",
              "connection_level": "debug",
              "duration_ms": 86,
              "event": "http",
              "method": "POST",
              "provider": "http",
              "rows": 1,
              "status": 200,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] POST https://api.example.test/_search 200 OK 86ms 512B"
          },
          {
            "event": "http_headers",
            "property": "log.level.http.headers",
            "label": "Headers and parameters",
            "description": "Sanitized request and response headers plus query parameters.",
            "default": "trace",
            "captures": [
              "headers",
              "query parameters"
            ],
            "example": {
              "connection": "search",
              "connection_level": "trace",
              "duration_ms": 86,
              "event": "http_headers",
              "method": "POST",
              "provider": "http",
              "query": [
                {
                  "name": "namespace",
                  "value": "tenant-x"
                }
              ],
              "request_headers": [
                {
                  "name": "Authorization",
                  "value": "Bearer ********"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ],
              "response_headers": [
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ],
              "rows": 1,
              "status": 200,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] POST https://api.example.test/_search 200 OK 86ms 512B\nRequest Headers\nAuthorization: Bearer ********, Content-Type: application/json\nQuery Parameters\nnamespace: tenant-x\nResponse Headers\nContent-Type: application/json"
          },
          {
            "event": "http_request_body",
            "property": "log.level.http.request.body",
            "label": "Request body",
            "description": "A bounded sanitized request body.",
            "default": "trace1",
            "captures": [
              "request body"
            ],
            "example": {
              "body_size": 68,
              "connection": "search",
              "connection_level": "trace1",
              "duration_ms": 86,
              "event": "http_request_body",
              "method": "POST",
              "provider": "http",
              "request_body": "{\"query\":{\"match_all\":{}},\"token\":\"********\"}",
              "rows": 1,
              "status": 200,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] POST https://api.example.test/_search 200 OK 86ms 512B\nRequest Body\n{\n  \"query\": {\n    \"match_all\": {}\n  },\n  \"token\": \"********\"\n}"
          },
          {
            "event": "http_response_body",
            "property": "log.level.http.response.body",
            "label": "Response body",
            "description": "A bounded sanitized response body with explicit truncation metadata.",
            "default": "trace2",
            "captures": [
              "response body"
            ],
            "example": {
              "body_size": 512,
              "connection": "search",
              "connection_level": "trace2",
              "duration_ms": 86,
              "event": "http_response_body",
              "method": "POST",
              "provider": "http",
              "response_body": "{\"hits\":[\"...\"]}",
              "rows": 1,
              "status": 200,
              "truncated": true,
              "url": "https://api.example.test/_search"
            },
            "prettyExample": "[http/search] POST https://api.example.test/_search 200 OK 86ms 512B\nResponse Body (truncated)\n{\n  \"hits\": [\n    \"...\"\n  ]\n}"
          }
        ]
      },
      "x-clicky-order": 8
    },
    "name": {
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "properties": {
      "allOf": [
        {
          "if": {
            "properties": {
              "authType": {
                "const": "basic"
              }
            },
            "required": [
              "authType"
            ]
          },
          "then": {
            "properties": {
              "password": {
                "format": "password",
                "title": "Password",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "secret",
                "x-clicky-order": 2
              },
              "username": {
                "format": "password",
                "title": "Username",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "value",
                "x-clicky-order": 1
              }
            },
            "required": [
              "username",
              "password"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authType": {
                "const": "oauth"
              }
            },
            "required": [
              "authType"
            ]
          },
          "then": {
            "properties": {
              "clientID": {
                "format": "password",
                "title": "Client ID",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "value",
                "x-clicky-order": 1
              },
              "clientSecret": {
                "format": "password",
                "title": "Client Secret",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "secret",
                "x-clicky-order": 2
              },
              "scopes": {
                "description": "Comma-separated OAuth scopes",
                "title": "Scopes",
                "type": "string",
                "x-clicky-order": 4
              },
              "tokenURL": {
                "title": "Token URL",
                "type": "string",
                "x-clicky-order": 3
              }
            },
            "required": [
              "clientID",
              "clientSecret",
              "tokenURL"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authType": {
                "const": "mtls"
              }
            },
            "required": [
              "authType"
            ]
          },
          "then": {
            "properties": {
              "ca": {
                "format": "password",
                "title": "CA Certificate",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "secret",
                "x-clicky-order": 1
              },
              "cert": {
                "format": "password",
                "title": "Client Certificate",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "secret",
                "x-clicky-order": 2
              },
              "key": {
                "format": "password",
                "title": "Client Private Key",
                "type": "string",
                "x-clicky-component": "k8s-secret-selector",
                "x-clicky-default-source": "secret",
                "x-clicky-order": 3
              }
            },
            "required": [
              "cert",
              "key"
            ]
          }
        }
      ],
      "properties": {
        "authType": {
          "default": "none",
          "enum": [
            "none",
            "basic",
            "oauth",
            "mtls"
          ],
          "title": "Authentication",
          "type": "string",
          "x-clicky-order": 0,
          "x-enum-display": "segmented",
          "x-enum-labels": {
            "basic": "Basic",
            "mtls": "mTLS",
            "none": "None",
            "oauth": "OAuth"
          }
        }
      },
      "required": [
        "authType"
      ],
      "title": "Authentication",
      "type": "object",
      "x-clicky-order": 4
    },
    "type": {
      "const": "http",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "description": "Base URL of the HTTP endpoint",
      "title": "URL",
      "type": "string",
      "x-clicky-component": "k8s-url-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 2
    }
  },
  "required": [
    "name",
    "type",
    "url"
  ],
  "title": "Connection: http",
  "type": "object"
}
