{
  "$id": "zulip_chat.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "logging": {
      "additionalProperties": false,
      "description": "Choose which sanitized connection activity is emitted at each log level.",
      "title": "Logging",
      "type": "object",
      "x-clicky-component": "connection-logging-policy",
      "x-clicky-logging": {
        "family": "generic",
        "slowThreshold": "1s",
        "thresholdLabel": "Slow threshold",
        "events": [
          {
            "event": "error",
            "property": "log.level.error",
            "label": "Errors",
            "description": "Failed operations, including the sanitized request identity.",
            "default": "error",
            "captures": [
              "error",
              "operation",
              "duration"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "error",
              "duration_ms": 82,
              "error": "operation failed",
              "event": "error",
              "provider": "zulip_chat",
              "rows": 0,
              "sql": "SCAN cache"
            },
            "prettyExample": "[zulip_chat/cache] ERROR \u003e=[82ms] [rows:0] SCAN cache operation failed"
          },
          {
            "event": "slow",
            "property": "log.level.slow",
            "label": "Slow operations",
            "description": "Successful operations at or above the slow threshold.",
            "default": "warn",
            "captures": [
              "operation",
              "duration",
              "slow threshold"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "warn",
              "duration_ms": 1200,
              "event": "slow",
              "provider": "zulip_chat",
              "rows": 25,
              "slow_threshold_ms": 1000,
              "sql": "SCAN cache"
            },
            "prettyExample": "[zulip_chat/cache] SLOW \u003e= [1200ms] [rows:25] SCAN cache"
          },
          {
            "event": "operation",
            "property": "log.level.operation",
            "label": "Operation summary",
            "description": "One completion record for a successful provider operation.",
            "default": "debug",
            "captures": [
              "operation",
              "duration",
              "result summary"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "debug",
              "duration_ms": 18,
              "event": "operation",
              "provider": "zulip_chat",
              "rows": 12,
              "sql": "SCAN cache"
            },
            "prettyExample": "[zulip_chat/cache] [18ms] [rows:12] SCAN cache"
          }
        ]
      },
      "x-clicky-order": 8
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "properties": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "kubeconfig": {
          "description": "Optional path on the server. Leave empty to use normal Kubernetes configuration discovery.",
          "title": "Kubeconfig file",
          "type": "string",
          "x-clicky-component": "k8s-kubeconfig-selector",
          "x-clicky-order": -2
        },
        "kubecontext": {
          "description": "Optional context in the selected kubeconfig. Leave empty to use its current context.",
          "title": "Kubecontext",
          "type": "string",
          "x-clicky-component": "k8s-context-selector",
          "x-clicky-order": -1
        }
      },
      "title": "Properties",
      "type": "object",
      "x-clicky-order": 7,
      "x-columns": 2
    },
    "type": {
      "const": "zulip_chat",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "title": "Connection: zulip_chat",
  "type": "object"
}
