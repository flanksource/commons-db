{
  "$id": "azure.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "password": {
      "format": "password",
      "title": "Client Secret",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "secret",
      "x-clicky-order": 5
    },
    "properties": {
      "properties": {
        "tenant": {
          "title": "Tenant ID",
          "type": "string",
          "x-clicky-order": 7
        }
      },
      "required": [
        "tenant"
      ],
      "title": "Properties",
      "type": "object"
    },
    "type": {
      "const": "azure",
      "title": "Type",
      "type": "string"
    },
    "username": {
      "title": "Client ID",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 4
    }
  },
  "required": [
    "name",
    "type",
    "username",
    "password",
    "properties"
  ],
  "title": "Connection: azure",
  "type": "object"
}
