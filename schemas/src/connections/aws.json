{
  "$id": "aws.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "insecure_tls": {
      "title": "Insecure TLS",
      "type": "boolean",
      "x-clicky-order": 3
    },
    "logging": {
      "additionalProperties": false,
      "description": "Choose which sanitized connection activity is emitted at each log level.",
      "title": "Logging",
      "type": "object",
      "x-clicky-component": "connection-logging-policy",
      "x-clicky-logging": {
        "family": "generic",
        "slowThreshold": "1s",
        "thresholdLabel": "Slow threshold",
        "events": [
          {
            "event": "error",
            "property": "log.level.error",
            "label": "Errors",
            "description": "Failed operations, including the sanitized request identity.",
            "default": "error",
            "captures": [
              "error",
              "operation",
              "duration"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "error",
              "duration_ms": 82,
              "error": "operation failed",
              "event": "error",
              "provider": "aws",
              "rows": 0,
              "sql": "SCAN cache"
            },
            "prettyExample": "[aws/cache] ERROR \u003e=[82ms] [rows:0] SCAN cache operation failed"
          },
          {
            "event": "slow",
            "property": "log.level.slow",
            "label": "Slow operations",
            "description": "Successful operations at or above the slow threshold.",
            "default": "warn",
            "captures": [
              "operation",
              "duration",
              "slow threshold"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "warn",
              "duration_ms": 1200,
              "event": "slow",
              "provider": "aws",
              "rows": 25,
              "slow_threshold_ms": 1000,
              "sql": "SCAN cache"
            },
            "prettyExample": "[aws/cache] SLOW \u003e= [1200ms] [rows:25] SCAN cache"
          },
          {
            "event": "operation",
            "property": "log.level.operation",
            "label": "Operation summary",
            "description": "One completion record for a successful provider operation.",
            "default": "debug",
            "captures": [
              "operation",
              "duration",
              "result summary"
            ],
            "example": {
              "connection": "cache",
              "connection_level": "debug",
              "duration_ms": 18,
              "event": "operation",
              "provider": "aws",
              "rows": 12,
              "sql": "SCAN cache"
            },
            "prettyExample": "[aws/cache] [18ms] [rows:12] SCAN cache"
          }
        ]
      },
      "x-clicky-order": 8
    },
    "name": {
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "password": {
      "format": "password",
      "title": "Secret Access Key",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "secret",
      "x-clicky-order": 5
    },
    "properties": {
      "properties": {
        "assumeRole": {
          "title": "Assume Role ARN",
          "type": "string",
          "x-clicky-order": 8
        },
        "region": {
          "title": "Region",
          "type": "string",
          "x-clicky-order": 7
        }
      },
      "title": "Properties",
      "type": "object"
    },
    "type": {
      "const": "aws",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "description": "Overrides the region's AWS endpoint",
      "title": "Endpoint",
      "type": "string",
      "x-clicky-component": "k8s-url-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 2
    },
    "username": {
      "title": "Access Key ID",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 4
    }
  },
  "required": [
    "name",
    "type"
  ],
  "title": "Connection: aws",
  "type": "object"
}
