{
  "$id": "aws.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "insecure_tls": {
      "title": "Insecure TLS",
      "type": "boolean",
      "x-clicky-order": 3
    },
    "name": {
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "password": {
      "format": "password",
      "title": "Secret Access Key",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "secret",
      "x-clicky-order": 5
    },
    "properties": {
      "properties": {
        "assumeRole": {
          "title": "Assume Role ARN",
          "type": "string",
          "x-clicky-order": 8
        },
        "region": {
          "title": "Region",
          "type": "string",
          "x-clicky-order": 7
        }
      },
      "title": "Properties",
      "type": "object"
    },
    "type": {
      "const": "aws",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "description": "Overrides the region's AWS endpoint",
      "title": "Endpoint",
      "type": "string",
      "x-clicky-component": "k8s-url-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 2
    },
    "username": {
      "title": "Access Key ID",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 4
    }
  },
  "required": [
    "name",
    "type"
  ],
  "title": "Connection: aws",
  "type": "object"
}
