{
  "$id": "clickhouse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "logging": {
      "additionalProperties": false,
      "description": "Choose which sanitized connection activity is emitted at each log level.",
      "title": "Logging",
      "type": "object",
      "x-clicky-component": "connection-logging-policy",
      "x-clicky-logging": {
        "family": "sql",
        "slowThreshold": "1s",
        "thresholdLabel": "Slow threshold",
        "events": [
          {
            "event": "error",
            "property": "log.level.error",
            "label": "Errors",
            "description": "Failed operations, including the sanitized request identity.",
            "default": "error",
            "captures": [
              "error",
              "operation",
              "duration"
            ],
            "example": {
              "connection": "warehouse",
              "connection_level": "error",
              "duration_ms": 82,
              "error": "syntax error",
              "event": "error",
              "provider": "clickhouse",
              "rows": 0,
              "sql": "SELECT * FROM orders WHERE tenant_id = ?"
            },
            "prettyExample": "[clickhouse/warehouse] ERROR \u003e=[82ms] [rows:0] syntax error SELECT * FROM orders WHERE tenant_id = ?"
          },
          {
            "event": "slow",
            "property": "log.level.slow",
            "label": "Slow operations",
            "description": "Successful operations at or above the slow threshold.",
            "default": "warn",
            "captures": [
              "operation",
              "duration",
              "slow threshold"
            ],
            "example": {
              "connection": "warehouse",
              "connection_level": "warn",
              "duration_ms": 1200,
              "event": "slow",
              "provider": "clickhouse",
              "rows": 25,
              "slow_threshold_ms": 1000,
              "sql": "SELECT * FROM orders WHERE tenant_id = ?"
            },
            "prettyExample": "[clickhouse/warehouse] SLOW SQL \u003e= [1200ms] [rows:25] SELECT * FROM orders WHERE tenant_id = ?"
          },
          {
            "event": "sql",
            "property": "log.level.sql",
            "label": "SQL statement",
            "description": "The sanitized SQL statement and its completion metrics.",
            "default": "trace",
            "captures": [
              "statement",
              "duration",
              "rows"
            ],
            "example": {
              "connection": "warehouse",
              "connection_level": "trace",
              "duration_ms": 48,
              "event": "sql",
              "provider": "clickhouse",
              "rows": 25,
              "sql": "SELECT * FROM orders WHERE tenant_id = ?"
            },
            "prettyExample": "[clickhouse/warehouse] [48ms] [rows:25] SELECT * FROM orders WHERE tenant_id = ?"
          },
          {
            "event": "sql_params",
            "property": "log.level.sql.params",
            "label": "SQL parameters",
            "description": "Bound arguments, with credential-shaped values redacted.",
            "default": "trace1",
            "captures": [
              "bound arguments"
            ],
            "example": {
              "connection": "warehouse",
              "connection_level": "trace1",
              "duration_ms": 48,
              "event": "sql_params",
              "params": [
                "t****"
              ],
              "provider": "clickhouse",
              "rows": 25
            },
            "prettyExample": "[clickhouse/warehouse] params [t****]"
          }
        ]
      },
      "x-clicky-order": 8
    },
    "name": {
      "title": "Name",
      "type": "string",
      "x-clicky-order": 0
    },
    "namespace": {
      "title": "Namespace",
      "type": "string",
      "x-clicky-component": "k8s-namespace-selector",
      "x-clicky-order": 1
    },
    "password": {
      "format": "password",
      "title": "Password",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "secret",
      "x-clicky-order": 5
    },
    "properties": {
      "description": "Applied to every query opened through this connection. Missing values use these safe defaults.",
      "properties": {
        "max_bytes_to_read": {
          "default": "268435456",
          "description": "Maximum uncompressed source bytes a query may scan",
          "pattern": "^[1-9][0-9]*$",
          "title": "Maximum bytes to read",
          "type": "string",
          "x-clicky-order": 2,
          "x-clicky-unit": "bytes"
        },
        "max_execution_time": {
          "default": "10",
          "description": "Server-side query execution limit in seconds",
          "pattern": "^[1-9][0-9]*$",
          "title": "Maximum execution time",
          "type": "string",
          "x-clicky-order": 0,
          "x-input-suffix": "seconds"
        },
        "max_memory_usage": {
          "default": "536870912",
          "description": "Maximum memory in bytes for one query",
          "pattern": "^[1-9][0-9]*$",
          "title": "Maximum memory usage",
          "type": "string",
          "x-clicky-order": 3,
          "x-clicky-unit": "bytes"
        },
        "max_rows_to_read": {
          "default": "1000000",
          "description": "Maximum source rows a query may scan",
          "pattern": "^[1-9][0-9]*$",
          "title": "Maximum rows to read",
          "type": "string",
          "x-clicky-order": 1,
          "x-clicky-unit": "count",
          "x-input-suffix": "rows"
        },
        "max_threads": {
          "default": "4",
          "description": "Maximum worker threads available to one query",
          "pattern": "^[1-9][0-9]*$",
          "title": "Maximum threads",
          "type": "string",
          "x-clicky-order": 4,
          "x-input-suffix": "threads"
        },
        "read_overflow_mode": {
          "default": "throw",
          "description": "Action when a row or byte read limit is exceeded",
          "enum": [
            "throw",
            "break"
          ],
          "title": "Read overflow",
          "type": "string",
          "x-clicky-order": 5,
          "x-enum-display": "segmented",
          "x-enum-labels": {
            "break": "Break",
            "throw": "Throw"
          }
        },
        "timeout_overflow_mode": {
          "default": "throw",
          "description": "Action when the execution time limit is exceeded",
          "enum": [
            "throw",
            "break"
          ],
          "title": "Timeout overflow",
          "type": "string",
          "x-clicky-order": 6,
          "x-enum-display": "segmented",
          "x-enum-labels": {
            "break": "Break",
            "throw": "Throw"
          }
        }
      },
      "title": "Query limits",
      "type": "object",
      "x-clicky-order": 7,
      "x-column-min-width": "16rem",
      "x-columns": 2
    },
    "type": {
      "const": "clickhouse",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "description": "clickhouse://user:pass@host:9000/db",
      "title": "URL",
      "type": "string",
      "x-clicky-component": "k8s-url-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 2
    },
    "username": {
      "title": "Username",
      "type": "string",
      "x-clicky-component": "k8s-secret-selector",
      "x-clicky-default-source": "value",
      "x-clicky-order": 4
    }
  },
  "required": [
    "name",
    "type",
    "url"
  ],
  "title": "Connection: clickhouse",
  "type": "object"
}
